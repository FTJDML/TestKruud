# ---------------------------------------------------------------------------
# HomeAndLivingDeals.nl — environment
#
# Kopieer naar .env en vul in. Dit bestand bevat nooit echte waarden.
# Genereer secrets bijvoorbeeld met:  openssl rand -base64 36
#
# .env staat in .gitignore en hoort nooit in Git of in een image.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Draaimodus
# ---------------------------------------------------------------------------
# development | test | production
# Staat los van NODE_ENV: `next build` zet NODE_ENV=production, terwijl een
# build nog geen productieomgeving is. Productie is dus een expliciete keuze.
# Met APP_ENV=production weigert de app te starten zolang de verplichte secrets
# hieronder ontbreken of nog voorbeeldwaarden zijn.
APP_ENV="development"

# ---------------------------------------------------------------------------
# Database (Prisma + PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://gebruiker:wachtwoord@localhost:5432/homeandlivingdeals?schema=public"

# ---------------------------------------------------------------------------
# Publieke basis-URL, gebruikt voor canonicals, sitemap en Open Graph.
# In productie verplicht https.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Functievlaggen — alleen "true" of "false"
# ---------------------------------------------------------------------------
# Demo-producten en demobronnen (fixtures en de open democatalogus) zichtbaar en
# seedbaar. Standaard aan buiten productie, standaard uit in productie.
DEMO_CONTENT_ENABLED="true"

# Zolang dit uit staat, krijgt de hele site noindex, blokkeert robots.txt alles
# en is de sitemap leeg. Zet pas op "true" bij de echte livegang.
SEARCH_ENGINE_INDEXING_ENABLED="false"

# Server-side hoofdschakelaar voor advertentieposities.
ADS_ENABLED="false"

# Wanneer dit uit staat, gaat /go/[offerId] altijd rechtstreeks naar de winkel,
# ook wanneer er al een affiliate-URL bij een aanbieding staat.
AFFILIATE_LINKS_ENABLED="false"

# ---------------------------------------------------------------------------
# Advertenties (clientzijde; moet dezelfde waarde hebben als ADS_ENABLED)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADS_ENABLED="false"
# none | adsense
NEXT_PUBLIC_AD_PROVIDER="none"
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""

# ---------------------------------------------------------------------------
# Redactionele content
# fixture | template | anthropic
# ---------------------------------------------------------------------------
CONTENT_PROVIDER="template"
# Alleen nodig bij CONTENT_PROVIDER=anthropic. Een Enterprise- of
# consumentenlogin is geen API-key.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# ---------------------------------------------------------------------------
# Jobs, cron en worker
# ---------------------------------------------------------------------------
# Bearer-token voor /api/cron/daily. Minimaal 24 tekens in productie.
CRON_SECRET=""
# Tijdstip van de dagelijkse worker-run (Europe/Amsterdam).
WORKER_DAILY_HOUR="6"
WORKER_DAILY_MINUTE="15"
# Zet op "true" om direct bij het starten van de worker één run te doen.
WORKER_RUN_ON_START="false"

# Duidelijke, herkenbare user-agent voor feeds en toegestane scrapes.
SCRAPER_USER_AGENT="HomeAndLivingDealsBot/1.0 (+https://homeandlivingdeals.nl/over)"
SCRAPER_TIMEOUT_MS="15000"
SCRAPER_MAX_CONCURRENCY="2"
SCRAPER_REQUESTS_PER_MINUTE="30"
# Zet op "true" om de optionele Playwright-fetcher toe te staan (alleen voor
# bronnen die JavaScript nodig hebben én scraping toestaan).
SCRAPER_ALLOW_BROWSER="false"

# ---------------------------------------------------------------------------
# Adminpaneel (httpOnly sessiecookie)
# ---------------------------------------------------------------------------
ADMIN_USERNAME=""
# Minimaal 12 tekens in productie.
ADMIN_PASSWORD=""
# Minimaal 32 tekens; ondertekent de adminsessiecookie.
ADMIN_SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Alleen voor Docker Compose
# ---------------------------------------------------------------------------
POSTGRES_USER="hald"
POSTGRES_PASSWORD=""
POSTGRES_DB="homeandlivingdeals"
POSTGRES_PORT="5432"
APP_PORT="3000"
# Productie (docker-compose.production.yml): domeinnaam en e-mail voor Caddy.
SITE_DOMAIN=""
ACME_EMAIL=""
