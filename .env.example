# ---------------------------------------------------------------------------
# HomeAndLivingDeals.nl — environment
# Kopieer naar .env en pas aan. Alles hieronder werkt lokaal zonder betaalde
# externe diensten.
# ---------------------------------------------------------------------------

# Database (Prisma + PostgreSQL)
DATABASE_URL="postgresql://hald:hald@localhost:5432/homeandlivingdeals?schema=public"

# Publieke basis-URL, gebruikt voor canonicals, sitemap en Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Advertenties (in de MVP uitgeschakeld)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADS_ENABLED="false"
# none | adsense
NEXT_PUBLIC_AD_PROVIDER="none"
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""

# ---------------------------------------------------------------------------
# Redactionele content
# fixture | template | anthropic
# ---------------------------------------------------------------------------
CONTENT_PROVIDER="template"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# ---------------------------------------------------------------------------
# Jobs en cron
# ---------------------------------------------------------------------------
# Vereist voor POST/GET op /api/cron/daily (Authorization: Bearer <secret>)
CRON_SECRET="verander-dit-in-productie"
# Duidelijke, herkenbare user-agent voor feeds en toegestane scrapes.
SCRAPER_USER_AGENT="HomeAndLivingDealsBot/0.1 (+https://homeandlivingdeals.nl/over)"
SCRAPER_TIMEOUT_MS="15000"
SCRAPER_MAX_CONCURRENCY="2"
SCRAPER_REQUESTS_PER_MINUTE="30"
# Zet op "true" om de optionele Playwright-fetcher toe te staan (alleen voor
# bronnen die JavaScript nodig hebben én scraping toestaan).
SCRAPER_ALLOW_BROWSER="false"

# ---------------------------------------------------------------------------
# Admin (httpOnly sessiecookie)
# ---------------------------------------------------------------------------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="verander-dit-wachtwoord"
# Minimaal 32 tekens; ondertekent de adminsessiecookie.
ADMIN_SESSION_SECRET="verander-dit-in-een-lange-willekeurige-string"

# ---------------------------------------------------------------------------
# Demo-inhoud
# ---------------------------------------------------------------------------
# Zet op "false" zodra echte merchantdata beschikbaar is.
SEED_DEMO_CONTENT="true"
