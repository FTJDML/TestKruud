# ---------------------------------------------------------------------------
# Niets uit deze lijst hoort in Git. Secrets, databasegegevens, uploads en
# build-output blijven lokaal of op de server.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnpm-store/

# Build-output
.next/
out/
build/
dist/
*.tsbuildinfo
tsconfig.tsbuildinfo
next-env.d.ts

# Environment en secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
.secrets/
*.secret

# Database: dumps, back-ups en lokale datamappen
backups/
*.dump
*.sql.gz
*.sqlite
*.sqlite3
*.db
pgdata/
postgres-data/

# Statische opname van de stagingomgeving (scripts/build-staging-artifact.mjs).
# Eén bestand van enkele megabytes met ingesloten afbeeldingen; opnieuw te maken
# met `pnpm staging:artifact`.
staging/

# Uploads en door de app gegenereerde media
uploads/
public/uploads/
storage/

# Tests en tooling
coverage/
test-results/
playwright-report/
playwright/.cache/
.vitest/

# Logs
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# Editors en besturingssystemen
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Caddy-data wanneer de proxy lokaal buiten Docker draait
caddy-data/
caddy-config/
