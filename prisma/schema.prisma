// HomeAndLivingDeals.nl — datamodel
// De verbindingsstring staat in prisma.config.ts (Prisma 7) en wordt in de
// applicatie via de pg-driveradapter doorgegeven aan PrismaClient.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SourceType {
  FIXTURE
  CSV
  JSON
  XML
  HTML
  API
}

/**
 * Betrouwbaarheid van de productafbeelding; alleen VALID mag publiek.
 */
enum ImageStatus {
  PENDING
  VALID
  INVALID
}

/**
 * Hoe goed wij dit product kennen. Bepaalt wat de redactionele tekst mag
 * beweren: zonder HANDS_ON_TESTED nooit eerstehandservaring.
 */
enum ExperienceType {
  NOT_TESTED
  DESK_RESEARCHED
  HANDS_ON_TESTED
}

/**
 * Affiliatenetwerk van een merchant; DIRECT betekent zonder netwerk.
 */
enum AffiliateNetwork {
  DIRECT
  BOL
  AWIN
  DAISYCON
  TRADETRACKER
  AMAZON_CREATORS
}

/**
 * Hoeveel meetpunten er onder een prijsanalyse zitten.
 */
enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

/**
 * Hoe twee aanbiedingen aan hetzelfde product zijn gekoppeld.
 */
enum MatchMethod {
  EAN
  BRAND_MODEL
  MERCHANT_EXTERNAL_ID
  NORMALIZED_TITLE
  FUZZY
}

/**
 * Fuzzy matches worden nooit automatisch samengevoegd.
 */
enum MatchCandidateStatus {
  OPEN
  CONFIRMED
  REJECTED
}

enum ProductStatus {
  CANDIDATE
  DRAFT
  NEEDS_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ReferencePriceType {
  MERCHANT_WAS_PRICE
  RECOMMENDED_RETAIL_PRICE
  OWN_PREVIOUS_PRICE
  OWN_30_DAY_LOW
  OWN_90_DAY_MEDIAN
}

/** Hoe een prijs is vastgesteld. Zichtbaar op de productpagina bij MANUAL. */
enum PriceCheckMethod {
  FEED
  MANUAL
}

enum EditionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EditionSection {
  HERO
  /**
   * Historisch; nieuwe edities gebruiken BEST_DEALS.
   */
  TODAY
  BEST_DEALS
  LATEST_PRICE_DROPS
  EDITORS_PICK
  UNDER_100
  UNNECESSARY_BUT_GREAT
  DISCOVERY
}

/**
 * Openingsstijl van een redactionele tekst. Bewaard om variatie te kunnen
 * afdwingen: zie src/lib/ai/style/openings.ts.
 */
enum OpeningStyle {
  PRICE_DROP
  RECOGNIZABLE_PROBLEM
  VISUAL_SURPRISE
  USE_CASE_SCENE
  GIFT_REACTION
  DESIGN_OBSERVATION
  PRACTICAL_DISCOVERY
  DRY_HUMOR
  DIRECT_FACT
  EDITORIAL_QUESTION
}

enum ScrapeRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

/**
 * Redactionele archetypen. Elk type heeft eigen eisen (zie
 * src/lib/editorial/archetypes.ts), een eigen editor en een eigen template.
 */
enum EditorialPageType {
  COMPARISON
  BEST_OF
  BUDGET_GUIDE
  USE_CASE_GUIDE
  GIFT_GUIDE
  DESIGN_COLLECTION
  DEAL_COLLECTION
  PROBLEM_SOLUTION
  DISCOVERY_COLLECTION
}

/** Wat de bezoeker met de zoekopdracht wil. Bepaalt de opbouw van de pagina. */
enum SearchIntent {
  INFORMATIONAL
  COMMERCIAL_INVESTIGATION
  TRANSACTIONAL
  INSPIRATIONAL
}

/**
 * Publicatiestatus van redactionele objecten. `SCHEDULED` wacht op
 * `scheduledPublishAt`; AI-drafts komen altijd op `NEEDS_REVIEW`.
 */
enum PublicationStatus {
  DRAFT
  NEEDS_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

/** Rol van een product op een redactionele pagina. */
enum EditorialProductRole {
  SELECTED
  ALTERNATIVE
}

enum CriterionValueType {
  TEXT
  NUMBER
  BOOLEAN
  ENUM
}

/**
 * Een criteriumwaarde is pas bruikbaar wanneer zij is gecontroleerd.
 * `NOT_PROVIDED` betekent: de bron geeft dit niet — de pagina toont dan
 * "Niet opgegeven" en er wordt niets geraden.
 */
enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  NOT_PROVIDED
}

enum EvidenceSourceType {
  MANUFACTURER_DOCUMENTATION
  MERCHANT_FEED
  AFFILIATE_API
  MANUAL_PRICE_CHECK
  OWN_PRICE_HISTORY
  OWN_HANDS_ON_TEST
  LICENSED_SOURCE
  OTHER_VERIFIED_SOURCE
}

enum InternalLinkTargetType {
  CLUSTER
  CATEGORY
  COLLECTION
  EDITORIAL_PAGE
  PRODUCT
}

enum InternalLinkStatus {
  SUGGESTED
  APPROVED
  REJECTED
}

enum ContentPlanEntryType {
  PRODUCT
  EDITORIAL_PAGE
}

enum ContentPlanStatus {
  PLANNED
  IN_PROGRESS
  DONE
  CANCELLED
}

model Merchant {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  domain           String
  sourceType       SourceType       @default(FIXTURE)
  enabled          Boolean          @default(true)
  scrapingAllowed  Boolean          @default(false)
  feedUrl          String?
  trustScore       Int              @default(50)
  /**
   * Feedconfiguratie en veldmapping. Bevat nooit secrets: alleen de namen van
   * environment variables (zie src/merchants/schemas/feed-config.ts).
   */
  configuration    Json             @default("{}")
  affiliateNetwork AffiliateNetwork @default(DIRECT)
  /**
   * Extra hosts waarvan next/image afbeeldingen mag optimaliseren.
   */
  imageHosts       String[]         @default([])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  offers         Offer[]
  scrapeRuns     ScrapeRun[]
  outboundClicks OutboundClick[]

  @@index([enabled])
}

model Product {
  id                     String         @id @default(cuid())
  slug                   String         @unique
  externalId             String?
  ean                    String?        @unique
  brand                  String?
  model                  String?
  title                  String
  normalizedTitle        String
  primaryCategory        String
  shortSourceDescription String?
  specifications         Json           @default("{}")
  imageUrl               String
  imageAlt               String
  /**
   * Alleen VALID komt in publieke grids, edities, sitemap en JSON-LD.
   */
  imageStatus            ImageStatus    @default(PENDING)
  imageCheckedAt         DateTime?
  imageContentType       String?
  imageWidth             Int?
  imageHeight            Int?
  /**
   * De URL zoals de bron haar aanleverde, vóór normalisatie.
   */
  imageSourceUrl         String?
  /**
   * Waarop wij het gebruik van deze afbeelding baseren, bijvoorbeeld
   * "open-icecat", "mediakit-fabrikant" of "eigen-foto". Leeg betekent: geen
   * vastgelegde grondslag, en dan hoort de afbeelding niet publiek te staan.
   */
  imageUsageBasis        String?
  /** Bronvermelding zoals die bij de afbeelding hoort. */
  imageAttribution       String?
  /** Waar de productgegevens vandaan komen, bijvoorbeeld "open-icecat". */
  dataSource             String?
  /** Sleutel van dit product bij die bron, voor herhaalbare imports. */
  dataSourceRef          String?
  manufacturerName       String?
  manufacturerUrl        String?
  imageFailureReason     String?
  /**
   * Laatst gevalideerde afbeelding; een kapotte nieuwe URL vervangt haar niet.
   */
  lastValidImageUrl      String?
  experienceType         ExperienceType @default(NOT_TESTED)
  status                 ProductStatus  @default(CANDIDATE)
  isDemo                 Boolean        @default(false)
  uniquenessScore        Int            @default(0)
  usefulnessScore        Int            @default(0)
  storyScore             Int            @default(0)
  giftabilityScore       Int            @default(0)
  visualQualityScore     Int            @default(60)
  collections            String[]       @default([])
  publishedAt            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  offers          Offer[]
  editorial       EditorialContent?
  analysis        DealAnalysis?
  editionItems    DailyEditionItem[]
  saves           AnonymousSave[]
  outboundClicks  OutboundClick[]
  matchCandidates ProductMatchCandidate[] @relation("matchSource")
  matchedBy       ProductMatchCandidate[] @relation("matchTarget")
  editorialPages  EditorialPageProduct[]
  featuredOnPages EditorialPage[]         @relation("featuredOnPages")
  criterionValues ProductCriterionValue[]
  planEntries     ContentPlanEntry[]

  @@index([status, imageStatus])
  @@index([status, primaryCategory])
  @@index([normalizedTitle])
  @@index([createdAt])
}

model Offer {
  id                 String              @id @default(cuid())
  productId          String
  merchantId         String
  externalOfferId    String?
  currentPrice       Decimal             @db.Decimal(10, 2)
  referencePrice     Decimal?            @db.Decimal(10, 2)
  referencePriceType ReferencePriceType?
  currency           String              @default("EUR")
  discountPercentage Int?
  /**
   * Alleen gevuld wanneer de bron verzendkosten betrouwbaar meelevert.
   */
  shippingCost       Decimal?            @db.Decimal(10, 2)
  inStock            Boolean             @default(true)
  /**
   * Ruwe voorraadtekst uit de bron, voor uitleg in het adminpaneel.
   */
  availabilityLabel  String?
  /**
   * Hoe deze prijs is vastgesteld: `FEED` door een geautomatiseerde bron, of
   * `MANUAL` door een mens die de winkelpagina heeft nagekeken. Bij MANUAL staat
   * dat ook op de productpagina, zodat een bezoeker weet wat hij ziet.
   */
  priceCheckMethod   PriceCheckMethod    @default(FEED)
  productGroup       String?
  variantId          String?
  destinationUrl     String
  affiliateUrl       String?
  promotionEndsAt    DateTime?
  checkedAt          DateTime            @default(now())
  staleAt            DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  merchant       Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  snapshots      PriceSnapshot[]
  editionItems   DailyEditionItem[]
  outboundClicks OutboundClick[]

  @@unique([merchantId, externalOfferId])
  @@index([productId])
  @@index([checkedAt])
}

model PriceSnapshot {
  id             String   @id @default(cuid())
  offerId        String
  price          Decimal  @db.Decimal(10, 2)
  referencePrice Decimal? @db.Decimal(10, 2)
  inStock        Boolean  @default(true)
  capturedAt     DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, capturedAt])
}

model EditorialContent {
  id                 String         @id @default(cuid())
  productId          String         @unique
  headline           String
  teaser             String
  longDescription    String
  whyItStandsOut     String
  bestFor            Json           @default("[]")
  caveat             String
  seoTitle           String
  metaDescription    String
  tags               Json           @default("[]")
  promptVersion      String
  aiProvider         String
  sourceFactsHash    String?
  /**
   * Versie van de prijsanalyse waarop deze tekst is gebaseerd.
   */
  analysisVersion    String?
  generationProvider String?
  generationModel    String?
  generationWarnings Json           @default("[]")
  /**
   * Korte opsomming van de feiten waarop de tekst zich baseert.
   */
  evidenceSummary    String?
  experienceType     ExperienceType @default(NOT_TESTED)
  /**
   * Gekozen openingsstijl en een hash van de openingszin en de slotzin. Samen
   * voorkomen zij dat teksten op elkaar gaan lijken.
   */
  openingStyle       OpeningStyle?
  openingHash        String?
  closingHash        String?
  /** Versie van de stijlregels waaronder deze tekst is geschreven. */
  styleVersion       String?
  /** Stijlbevindingen die de redactie nog kan opvolgen. */
  styleWarnings      Json           @default("[]")
  generatedAt        DateTime       @default(now())
  reviewedAt         DateTime?
  /**
   * Moment waarop een mens de tekst inhoudelijk heeft gecontroleerd. Zonder deze
   * datum is machinegegenereerde tekst nooit indexeerbaar.
   */
  humanReviewedAt    DateTime?
  /** Heeft een mens de tekst zelf aangepast? */
  humanEdited        Boolean        @default(false)
  /** Notities van de redacteur bij de beoordeling. */
  reviewerNotes      String?
  updatedAt          DateTime       @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([humanReviewedAt])
  @@index([generatedAt])
}

/**
 * Eigen prijsanalyse, volledig berekend uit PriceSnapshot-data door gewone
 * code. AI berekent hier niets: zie src/lib/analysis/price-analysis.ts.
 */
model DealAnalysis {
  id                        String          @id @default(cuid())
  productId                 String          @unique
  currency                  String          @default("EUR")
  currentPrice              Decimal         @db.Decimal(10, 2)
  previousObservedPrice     Decimal?        @db.Decimal(10, 2)
  lowestPrice30Days         Decimal?        @db.Decimal(10, 2)
  medianPrice90Days         Decimal?        @db.Decimal(10, 2)
  lowestPriceAllTime        Decimal?        @db.Decimal(10, 2)
  highestPrice90Days        Decimal?        @db.Decimal(10, 2)
  priceChangeAmount         Decimal?        @db.Decimal(10, 2)
  priceChangePercentage     Float?
  numberOfObservedPrices    Int             @default(0)
  numberOfComparedMerchants Int             @default(0)
  cheapestMerchantId        String?
  nextCheapestPrice         Decimal?        @db.Decimal(10, 2)
  differenceToNextMerchant  Decimal?        @db.Decimal(10, 2)
  firstSeenAt               DateTime?
  lastSeenAt                DateTime?
  lastPriceChangeAt         DateTime?
  dealDetectedAt            DateTime?
  calculatedAt              DateTime        @default(now())
  confidenceLevel           ConfidenceLevel @default(LOW)
  analysisVersion           String
  /**
   * Aantal dagen tussen de eerste en de laatste meting.
   */
  historyDays               Int             @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([dealDetectedAt])
  @@index([lastPriceChangeAt])
}

/**
 * Mogelijke koppeling tussen twee producten. Alleen fuzzy matches komen hier
 * terecht: die worden nooit automatisch samengevoegd, maar wachten op een mens.
 */
model ProductMatchCandidate {
  id                 String               @id @default(cuid())
  productId          String
  candidateProductId String
  method             MatchMethod
  similarity         Float
  status             MatchCandidateStatus @default(OPEN)
  reason             String?
  createdAt          DateTime             @default(now())
  reviewedAt         DateTime?

  product          Product @relation("matchSource", fields: [productId], references: [id], onDelete: Cascade)
  candidateProduct Product @relation("matchTarget", fields: [candidateProductId], references: [id], onDelete: Cascade)

  @@unique([productId, candidateProductId])
  @@index([status])
}

model DailyEdition {
  id          String        @id @default(cuid())
  editionDate DateTime      @unique @db.Date
  status      EditionStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())

  items DailyEditionItem[]

  @@index([status, editionDate])
}

model DailyEditionItem {
  id             String         @id @default(cuid())
  dailyEditionId String
  productId      String
  offerId        String
  position       Int
  section        EditionSection
  score          Float          @default(0)
  createdAt      DateTime       @default(now())

  edition DailyEdition @relation(fields: [dailyEditionId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  offer   Offer        @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([dailyEditionId, productId])
  @@index([dailyEditionId, section, position])
}

model AnonymousSave {
  id                 String   @id @default(cuid())
  productId          String
  anonymousVisitorId String
  createdAt          DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, anonymousVisitorId])
  @@index([anonymousVisitorId])
}

model OutboundClick {
  id                 String   @id @default(cuid())
  productId          String
  offerId            String
  merchantId         String
  anonymousVisitorId String?
  source             String   @default("unknown")
  createdAt          DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  offer    Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

model ScrapeRun {
  id              String          @id @default(cuid())
  merchantId      String
  status          ScrapeRunStatus @default(RUNNING)
  startedAt       DateTime        @default(now())
  finishedAt      DateTime?
  productsFound   Int             @default(0)
  productsCreated Int             @default(0)
  offersUpdated   Int             @default(0)
  errorMessage    String?
  createdAt       DateTime        @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, startedAt])
}

/**
 * Contentcluster: een thematische bundel van categorieën, producten en
 * redactionele pagina's. Een cluster komt pas prominent in de navigatie wanneer
 * het genoeg gepubliceerde producten én genoeg redactionele pagina's heeft; de
 * grenzen staan per cluster in de database (met defaults uit de environment).
 */
model ContentCluster {
  id                  String            @id @default(cuid())
  slug                String            @unique
  title               String
  /** Redactionele introductie op de clusterpagina. */
  introduction        String
  heroImage           String?
  /** Handmatige zichtbaarheid; de drempels hieronder gelden daarnaast. */
  visible             Boolean           @default(false)
  minProducts         Int               @default(15)
  minEditorialPages   Int               @default(2)
  /** Primaire onderwerpen; bepalen de redactionele richting, geen automatiek. */
  primaryTopics       String[]          @default([])
  /** Slugs van de onderliggende categorieën. */
  categorySlugs       String[]          @default([])
  seoTitle            String
  metaDescription     String
  status              PublicationStatus @default(DRAFT)
  displayOrder        Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  editorialPages EditorialPage[]
  planEntries    ContentPlanEntry[]

  @@index([status, visible])
}

/**
 * Redactionele pagina (vergelijking, koopgids, collectie). Zij is nooit
 * automatisch indexeerbaar: de IndexabilityQualityGate in
 * src/lib/editorial/quality-gate.ts beslist, en `indexable` is het opgeslagen
 * resultaat van die controle.
 */
model EditorialPage {
  id                        String            @id @default(cuid())
  type                      EditorialPageType
  title                     String
  slug                      String            @unique
  clusterId                 String?
  /** Eén echte gebruikersvraag; geen zoekwoordenlijst. */
  primaryQuery              String
  searchIntent              SearchIntent      @default(COMMERCIAL_INVESTIGATION)
  audience                  String?
  useCase                   String?
  /** Budgetgrenzen in centen; verplicht bij BUDGET_GUIDE en GIFT_GUIDE. */
  budgetMinCents            Int?
  budgetMaxCents            Int?
  introduction              String
  /** Hoe de selectie is gemaakt; verplicht waar het archetype dat eist. */
  methodology               String?
  selectionCriteria         String?
  conclusion                String?
  frequentlyAskedQuestions  Json              @default("[]")
  featuredProductId         String?
  /** Waarom dit product uitgelicht is, gekoppeld aan controleerbare criteria. */
  featuredReason            String?
  /** Verplicht aandachtspunt bij het uitgelichte product. */
  featuredCaveat            String?
  /** Wanneer een alternatief geschikter is. */
  featuredAlternativeNote   String?
  /** Label zoals "Beste voor kleine keukens"; zie src/lib/editorial/featured.ts. */
  featuredLabel             String?
  status                    PublicationStatus @default(DRAFT)
  scheduledPublishAt        DateTime?
  publishedAt               DateTime?
  lastFactCheckedAt         DateTime?
  reviewedAt                DateTime?
  reviewerNotes             String?
  /** Resultaat van de quality gate; nooit met de hand op true gezet. */
  indexable                 Boolean           @default(false)
  indexabilityReasons       Json              @default("[]")
  seoTitle                  String
  metaDescription           String
  canonicalUrl              String?
  heroImage                 String?
  /** Hash van de feiten waarop de tekst rust; wijzigt die, dan is review nodig. */
  contentFactsHash          String?
  /** Openingsstijl en hashes; zie src/lib/ai/style/openings.ts. */
  openingStyle              OpeningStyle?
  openingHash               String?
  closingHash               String?
  styleVersion              String?
  styleWarnings             Json              @default("[]")
  /** Moment waarop een mens de tekst inhoudelijk controleerde. */
  humanReviewedAt           DateTime?
  humanEdited               Boolean           @default(false)
  generationProvider        String?
  generationModel           String?
  generationWarnings        Json              @default("[]")
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  cluster         ContentCluster?         @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  featuredProduct Product?                @relation("featuredOnPages", fields: [featuredProductId], references: [id], onDelete: SetNull)
  products        EditorialPageProduct[]
  criteria        EditorialPageCriterion[]
  criterionValues ProductCriterionValue[]
  sources         EditorialPageSource[]
  planEntries     ContentPlanEntry[]

  @@index([status, indexable])
  @@index([type, status])
  @@index([clusterId])
  @@index([scheduledPublishAt])
}

/** Geselecteerde en alternatieve producten, met hun redactionele toelichting. */
model EditorialPageProduct {
  id              String               @id @default(cuid())
  editorialPageId String
  productId       String
  role            EditorialProductRole @default(SELECTED)
  position        Int                  @default(0)
  /** Voor welke doelgroep of use case dit product de beste keuze is. */
  bestForAudience String?
  /** Waarom dit product bij deze use case past; uit feiten, niet uit smaak. */
  recommendation  String?
  /** Minimaal één aandachtspunt per product. */
  caveat          String?
  /** Label zoals "Beste binnen dit budget". */
  label           String?
  /** Bewust boven het budget opgenomen, met uitleg. */
  exceedsBudget   Boolean              @default(false)
  budgetNote      String?
  createdAt       DateTime             @default(now())

  editorialPage EditorialPage @relation(fields: [editorialPageId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([editorialPageId, productId])
  @@index([editorialPageId, role, position])
}

/**
 * Bibliotheek van vergelijkingscriteria. Criteria zijn herbruikbaar over
 * pagina's; per pagina bepaalt EditorialPageCriterion de volgorde.
 */
model ComparisonCriterion {
  name           String             @id
  label          String
  valueType      CriterionValueType @default(TEXT)
  unit           String?
  /** Mag dit criterium alleen met een bron worden gevuld? */
  sourceRequired Boolean            @default(true)
  /** Null wanneer "hoger" niet beter is (bijvoorbeeld bij een kleur). */
  higherIsBetter Boolean?
  explanation    String
  displayOrder   Int                @default(0)
  createdAt      DateTime           @default(now())

  pages  EditorialPageCriterion[]
  values ProductCriterionValue[]
}

model EditorialPageCriterion {
  id              String   @id @default(cuid())
  editorialPageId String
  criterionName   String
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())

  editorialPage EditorialPage       @relation(fields: [editorialPageId], references: [id], onDelete: Cascade)
  criterion     ComparisonCriterion @relation(fields: [criterionName], references: [name], onDelete: Cascade)

  @@unique([editorialPageId, criterionName])
  @@index([editorialPageId, displayOrder])
}

/**
 * Waarde van één criterium voor één product op één pagina. Ontbreekt de waarde,
 * dan blijft de rij weg of staat zij op NOT_PROVIDED: de tabel toont dan
 * "Niet opgegeven". AI vult hier niets in.
 */
model ProductCriterionValue {
  id                 String             @id @default(cuid())
  editorialPageId    String
  productId          String
  criterionName      String
  value              String?
  sourceId           String?
  verifiedAt         DateTime?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  editorialPage EditorialPage       @relation(fields: [editorialPageId], references: [id], onDelete: Cascade)
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  criterion     ComparisonCriterion @relation(fields: [criterionName], references: [name], onDelete: Cascade)
  source        EvidenceSource?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([editorialPageId, productId, criterionName])
  @@index([editorialPageId, criterionName])
}

/** Bron achter een feit. Zonder bron geen gecontroleerde criteriumwaarde. */
model EvidenceSource {
  id           String             @id @default(cuid())
  sourceType   EvidenceSourceType
  title        String
  publisher    String?
  url          String?
  accessedAt   DateTime           @default(now())
  /** Welke soorten feiten deze bron dekt, bijvoorbeeld "prijs" of "afmetingen". */
  factTypes    String[]           @default([])
  notes        String?
  /** Mogen wij deze bron gebruiken? Zonder toestemming niet publiceren. */
  usageAllowed Boolean            @default(true)
  createdAt    DateTime           @default(now())

  criterionValues ProductCriterionValue[]
  pages           EditorialPageSource[]

  @@index([sourceType])
}

model EditorialPageSource {
  id              String   @id @default(cuid())
  editorialPageId String
  sourceId        String
  note            String?
  createdAt       DateTime @default(now())

  editorialPage EditorialPage  @relation(fields: [editorialPageId], references: [id], onDelete: Cascade)
  source        EvidenceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([editorialPageId, sourceId])
}

/**
 * Voorgestelde interne link. Suggesties worden automatisch gemaakt, maar een
 * link verschijnt pas na redactionele goedkeuring (`APPROVED`).
 */
model InternalLinkSuggestion {
  id         String                 @id @default(cuid())
  fromType   InternalLinkTargetType
  /** Slug of id, afhankelijk van het type. */
  fromRef    String
  toType     InternalLinkTargetType
  toRef      String
  anchorText String
  reason     String
  status     InternalLinkStatus     @default(SUGGESTED)
  createdAt  DateTime               @default(now())
  reviewedAt DateTime?

  @@unique([fromType, fromRef, toType, toRef])
  @@index([status])
  @@index([toType, toRef, status])
}

/**
 * Redactiekalender. Eén rij per gepland product of geplande pagina, met de
 * momenten waarop een fact-check, prijscontrole of update nodig is.
 */
model ContentPlanEntry {
  id                    String               @id @default(cuid())
  type                  ContentPlanEntryType
  title                 String
  productId             String?
  editorialPageId       String?
  clusterId             String?
  scheduledFor          DateTime
  factCheckDueAt        DateTime?
  priceCheckDueAt       DateTime?
  /** Seizoensperiode, bijvoorbeeld "sinterklaas-2026" of "zomer". */
  season                String?
  /** Waar dit op de homepage moet landen; een sectienaam of leeg. */
  homepagePlacement     String?
  updateReminderAt      DateTime?
  /** Opnieuw publiceren zodra wij een relevante prijsdaling meten. */
  republishOnPriceDrop  Boolean              @default(false)
  status                ContentPlanStatus    @default(PLANNED)
  notes                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  product       Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  editorialPage EditorialPage?  @relation(fields: [editorialPageId], references: [id], onDelete: Cascade)
  cluster       ContentCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)

  @@index([scheduledFor, status])
  @@index([type, status])
}
